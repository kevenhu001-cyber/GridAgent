<Application x:Class="GridAgent.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="GridAgentConversationBrush" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="GridAgentSendBrush" Color="#171717"/>
     <SolidColorBrush x:Key="GridAgentSendInkBrush" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="GridAgentBubbleBrush" Color="#F3F3F3"/>
     <SolidColorBrush x:Key="GridAgentSidebarBrush" Color="#F8F8F8"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
     <SolidColorBrush x:Key="GridAgentConversationBrush" Color="#212121"/>
     <SolidColorBrush x:Key="GridAgentSendBrush" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="GridAgentSendInkBrush" Color="#171717"/>
     <SolidColorBrush x:Key="GridAgentBubbleBrush" Color="#303030"/>
     <SolidColorBrush x:Key="GridAgentSidebarBrush" Color="#181818"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="GridAgentConversationBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="GridAgentSendBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
     <SolidColorBrush x:Key="GridAgentSendInkBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
     <SolidColorBrush x:Key="GridAgentBubbleBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="GridAgentSidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="EngineeringCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="BorderThickness" Value="1"/>
   </Style>
   <Style x:Key="UserMessageCardStyle" TargetType="Border" BasedOn="{StaticResource EngineeringCardStyle}">
    <Setter Property="Background" Value="{ThemeResource GridAgentBubbleBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="MaxWidth" Value="680"/>
   </Style>
   <Style x:Key="ConversationComposerStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource GridAgentConversationBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="MaxWidth" Value="820"/>
   </Style>
   <Style x:Key="ConversationSendStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource GridAgentSendBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource GridAgentSendInkBrush}"/>
    <Setter Property="CornerRadius" Value="19"/>
    <Setter Property="Width" Value="38"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Padding" Value="0"/>
   </Style>
   <Style x:Key="ConversationIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
   </Style>
   <Style x:Key="ConversationActivityButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="4,6"/>
    <Setter Property="CornerRadius" Value="8"/>
   </Style>
   <Style x:Key="WorkbenchRowStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
   </Style>
   <Style x:Key="WorkbenchListItemStyle" TargetType="ListViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="8,10"/>
    <Setter Property="MinHeight" Value="52"/>
   </Style>
   <DataTemplate x:Key="WorkbenchEntryTemplate">
    <StackPanel Spacing="4">
     <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </DataTemplate>
   <Style x:Key="WorkbenchPageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
   </Style>
   <Style x:Key="ConversationMetadataStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Style>
   <Style x:Key="ResultMessageCardStyle" TargetType="Border">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
