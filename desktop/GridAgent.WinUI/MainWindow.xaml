<Window x:Class="GridAgent.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:GridAgent.Windows" Title="GridAgent">
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TitleBar x:Name="AppTitleBar" Title="GridAgent" Subtitle="Engineering workspace"/>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="248" IsBackButtonVisible="Collapsed"
   IsSettingsVisible="True" SelectionChanged="Navigate" AlwaysShowHeader="False" CompactModeThresholdWidth="720" ExpandedModeThresholdWidth="1100">
   <NavigationView.MenuItems><NavigationViewItem Tag="chat" Content="Assistant" Icon="Message"/><NavigationViewItem Tag="tasks" Content="Research tasks" Icon="AllApps"/><NavigationViewItem Tag="models" Content="Models" Icon="Library"/><NavigationViewItem Tag="runs" Content="Simulation results" Icon="View"/><NavigationViewItem Tag="studies" Content="Studies" Icon="Document"/><NavigationViewItem Tag="tools" Content="Engineering tools" Icon="Repair"/><NavigationViewItem Tag="plugins" Content="Plugins" Icon="Manage"/><NavigationViewItem Tag="knowledge" Content="Knowledge" Icon="Book"/></NavigationView.MenuItems>
   <Grid Padding="0,0,12,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="12,0,12,8" AutomationProperties.Name="Operation notification"/>
    <Grid Grid.Row="1" x:Name="Pages" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
     <Grid x:Name="ChatPage" Padding="24,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="4"><TextBlock Text="Engineering assistant" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Ask a question, construct a model or run a verified research task." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
       <Button Grid.Column="1" Content="New session" Click="NewSession" VerticalAlignment="Top"/>
      </Grid>
      <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" Margin="0,16" VerticalScrollBarVisibility="Auto">
       <StackPanel x:Name="Messages" MaxWidth="860" Spacing="14" Padding="4,8" HorizontalAlignment="Stretch"/>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12" MaxWidth="860" HorizontalAlignment="Stretch">
       <StackPanel Spacing="8">
        <TextBox x:Name="Prompt" PlaceholderText="Describe an engineering problem…" MinHeight="64" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Research question" KeyDown="PromptKeyDown"/>
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="Mode" SelectedIndex="0" AutomationProperties.Name="Execution mode"><ComboBoxItem Content="Ask assistant"/><ComboBoxItem Content="Verified research"/><ComboBoxItem Content="Multi-agent research"/></ComboBox>
         <Button x:Name="SendButton" Grid.Column="1" Content="Send" Click="Send" Style="{StaticResource AccentButtonStyle}" MinWidth="84"/>
        </Grid>
        <TextBlock Text="Ctrl + Enter to send. Numerical conclusions require verification." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       </StackPanel>
      </Border>
     </Grid>
     <ScrollViewer x:Name="TasksPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Research tasks" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Manage execution, approval and recovery." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Open manifest…" Click="StartResearchManifest"/><Button Margin="0,0,8,8" Content="Verified Python…" Click="RunVerifiedPython"/><Button Margin="0,0,8,8" Content="Details" Click="ResearchStatus"/><Button Margin="0,0,8,8" Content="Resume" Click="ResumeResearch"/><Button Margin="0,0,8,8" Content="Cancel" Click="CancelResearch"/><Button Margin="0,0,8,8" Content="Approve repair" Click="ApproveResearch"/><Button Margin="0,0,8,8" Content="Use prompt as answer" Click="ClarifyResearch"/><Button Margin="0,0,8,8" Content="Export JSON" Click="ExportResearch"/></VariableSizedWrapGrid><ListView x:Name="ResearchList" DisplayMemberPath="Label" SelectionMode="Single" AutomationProperties.Name="ResearchList"/></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="ModelsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Models" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Inspect imported models and immutable model revisions." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Import ANDES model…" Click="ImportModel"/><Button Margin="0,0,8,8" Content="Available models" Click="Models"/><Button Margin="0,0,8,8" Content="View changes" Click="ModelRevisionDiff"/><Button Margin="0,0,8,8" Content="Run selected version" Click="RunModelRevision"/></VariableSizedWrapGrid><ListView x:Name="ModelRevisions" DisplayMemberPath="Label" SelectionMode="Single" AutomationProperties.Name="ModelRevisions"/></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="RunsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Simulation results" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Select a run to inspect its results. Select two to four for waveform comparison." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Refresh runs" Click="Runs"/><Button Margin="0,0,8,8" Content="Waveform" Click="OpenWaveform"/><Button Margin="0,0,8,8" Content="Compare waveforms" Click="OverlayWaveforms"/><Button Margin="0,0,8,8" Content="Scientific charts" Click="OpenScientificCharts"/><Button Margin="0,0,8,8" Content="Topology and parameters" Click="OpenTopology"/></VariableSizedWrapGrid><ListView x:Name="RunList" DisplayMemberPath="Label" SelectionMode="Multiple" AutomationProperties.Name="RunList"/></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="StudiesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Studies and sessions" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Resume an earlier conversation or inspect a saved report." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="Conversations" Style="{StaticResource SubtitleTextBlockStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open selected session" Click="OpenSession"/></StackPanel><ListView x:Name="SessionList" DisplayMemberPath="Label" SelectionMode="Single" AutomationProperties.Name="SessionList"/><TextBlock Text="Saved studies" Style="{StaticResource SubtitleTextBlockStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open report" Click="OpenStudy"/><Button Content="Resume DSR" Click="ResumeDsr"/></StackPanel><ListView x:Name="StudyList" DisplayMemberPath="Label" SelectionMode="Single" AutomationProperties.Name="StudyList"/></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="ToolsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Engineering tools" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Explicit operations for simulation, reproduction and evaluation." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="Simulation" Style="{StaticResource SubtitleTextBlockStyle}"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Simulation program…" Click="NativeProgram"/><Button Margin="0,0,8,8" Content="ANDES batch…" Click="AndesBatch"/><Button Margin="0,0,8,8" Content="Eigenanalysis" Click="Eigen"/><Button Margin="0,0,8,8" Content="Optimize dispatch" Click="Optimize"/><Button Margin="0,0,8,8" Content="Open DMQ" Click="Dmq"/><Button Margin="0,0,8,8" Content="DMQ reference" Click="DmqReference"/><Button Margin="0,0,8,8" Content="Open DSR…" Click="Dsr"/></VariableSizedWrapGrid><TextBlock Text="Paper reproduction" Style="{StaticResource SubtitleTextBlockStyle}"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Paper DMQ…" Click="PaperDmq"/><Button Margin="0,0,8,8" Content="Paper DSR…" Click="PaperDsr"/><Button Margin="0,0,8,8" Content="Mitigation…" Click="PaperMitigation"/><Button Margin="0,0,8,8" Content="DSR ranking" Click="PaperRank"/><Button Margin="0,0,8,8" Content="KPI CSV…" Click="PaperKpi"/></VariableSizedWrapGrid><TextBlock Text="Evaluation and safety" Style="{StaticResource SubtitleTextBlockStyle}"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Benchmark and repair…" Click="ModelRepair"/><Button Margin="0,0,8,8" Content="Modeling benchmark…" Click="ModelingBenchmark"/><Button Margin="0,0,8,8" Content="Engineering experience" Click="Experience"/><Button Margin="0,0,8,8" Content="Review Python draft…" Click="ReviewScript"/></VariableSizedWrapGrid></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="PluginsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Simulation plugins" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Install only the optional solvers you need. No marketplace or bundled downloads." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh catalog" Click="PluginCenter"/><Button Content="Register ngspice…" Click="RegisterNgspice"/></StackPanel><TextBox x:Name="PluginSearch" PlaceholderText="Search plugins" TextChanged="FilterPlugins" AutomationProperties.Name="Search plugins"/><StackPanel x:Name="PluginRows" Spacing="12"/></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="KnowledgePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Engineering knowledge" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Manage local reference packs and engineering experience." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Import references…" Click="ImportKnowledge"/><Button Margin="0,0,8,8" Content="Knowledge packs" Click="Knowledge"/><Button Margin="0,0,8,8" Content="Engineering experience" Click="Experience"/></VariableSizedWrapGrid></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Workspace, provider and appearance." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="Workspace" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <TextBlock x:Name="RuntimeStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBox x:Name="WorkspacePath" Header="Workspace directory" IsReadOnly="True" AutomationProperties.Name="Workspace directory"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open workspace…" Click="OpenWorkspace"/><Button Content="Refresh workspace" Click="Refresh"/></StackPanel>
      <TextBlock Text="Model provider" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <TextBox x:Name="ModelName" Header="Model name"/><TextBox x:Name="BaseUrl" Header="Base URL"/><PasswordBox x:Name="ApiKey" Header="API key (session only)"/>
      <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Load saved" Click="LoadModelSettings"/><Button Margin="0,0,8,8" Content="Save model" Click="SaveModelSettings"/><Button Margin="0,0,8,8" Content="Test connection" Click="TestModelConnection"/><Button Margin="0,0,8,8" Content="Automatic Python…" Click="PythonSettings"/></VariableSizedWrapGrid>
      <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <ComboBox x:Name="Theme" Header="App theme" SelectedIndex="0" SelectionChanged="ChangeTheme"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
     </StackPanel></StackPanel></ScrollViewer>
    </Grid>
    <Grid Grid.Row="2" Margin="12,8,12,0" ColumnSpacing="10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/>
     <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
     <Button Grid.Column="2" Content="Cancel research" Click="CancelResearch" x:Name="CancelButton" Visibility="Collapsed"/>
    </Grid>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
