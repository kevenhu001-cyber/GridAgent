<Window x:Class="GridAgent.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:GridAgent.Windows" Title="GridAgent">
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TitleBar x:Name="AppTitleBar" Title="GridAgent" Subtitle="by TopoDrive"/>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="248" IsBackButtonVisible="Collapsed"
   IsSettingsVisible="True" SelectionChanged="Navigate" ItemInvoked="NavigationInvoked" AlwaysShowHeader="False" CompactModeThresholdWidth="720" ExpandedModeThresholdWidth="1100">
   <NavigationView.MenuItems><NavigationViewItemHeader Content="Workspace"/><NavigationViewItem Tag="chat" Content="Assistant" x:Name="AssistantNavigation"><NavigationViewItem.Icon><SymbolIcon Symbol="Comment"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="RecentConversations" Content="Recent conversations" SelectsOnInvoked="False"><NavigationViewItem.Icon><SymbolIcon Symbol="Clock"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Tag="tasks" x:Name="ResearchNavigation" Content="Research tasks"><NavigationViewItem.Icon><SymbolIcon Symbol="AllApps"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Tag="models" Content="Models"><NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Tag="runs" x:Name="ResultsNavigation" Content="Simulation results"><NavigationViewItem.Icon><SymbolIcon Symbol="View"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Tag="studies" Content="Studies"><NavigationViewItem.Icon><SymbolIcon Symbol="Document"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItemHeader Content="Engineering"/><NavigationViewItem Tag="tools" Content="Engineering tools"><NavigationViewItem.Icon><SymbolIcon Symbol="Repair"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Tag="plugins" Content="Plugins"><NavigationViewItem.Icon><SymbolIcon Symbol="Manage"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Tag="knowledge" Content="Knowledge"><NavigationViewItem.Icon><SymbolIcon Symbol="Read"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
   <Grid Padding="0,0,12,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="12,0,12,8" AutomationProperties.Name="Operation notification"/>
    <Grid Grid.Row="1" x:Name="Pages" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
     <Grid x:Name="ChatPage" Padding="16,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="12" Margin="8,0,8,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="2">
        <TextBlock Text="GridAgent" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <TextBlock x:Name="ConversationModel" Text="Engineering assistant" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button Click="OpenConversationHistory" ToolTipService.ToolTip="Conversations" AutomationProperties.Name="Conversations" Style="{StaticResource SubtleButtonStyle}"><SymbolIcon Symbol="List"/></Button>
        <Button Click="NewSession" ToolTipService.ToolTip="New conversation" AutomationProperties.Name="New conversation" Style="{StaticResource SubtleButtonStyle}"><SymbolIcon Symbol="Add"/></Button>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,8">
       <ListView x:Name="Messages" Loaded="ConversationLoaded" SelectionMode="None" IsItemClickEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Conversation"
          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Disabled">
        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate></ListView.ItemsPanel>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate><local:ConversationMessageView/></DataTemplate></ListView.ItemTemplate>
       </ListView>
       <Button x:Name="JumpToLatest" Visibility="Collapsed" Content="Jump to latest" Click="JumpToLatestClick" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" AutomationProperties.Name="Jump to latest message"/>
       <StackPanel x:Name="EmptyConversation" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Spacing="12" Margin="20">
        <TextBlock Text="What are we working on?" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="Build a power network, analyze stability, or verify a simulation." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Button Content="Model a two-bus network" Click="UseSuggestion" HorizontalAlignment="Center"/>
        <Button Content="Analyze power-system stability" Click="UseSuggestion" HorizontalAlignment="Center"/>
       </StackPanel>
      </Grid>
      <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20" Padding="12" MaxWidth="820" HorizontalAlignment="Stretch">
       <StackPanel Spacing="8">
        <TextBox x:Name="Prompt" Background="Transparent" BorderThickness="0" PlaceholderText="Ask anything about your power system…" MinHeight="64" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Research question" KeyDown="PromptKeyDown"/>
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="Mode" SelectedIndex="0" AutomationProperties.Name="Execution mode"><ComboBoxItem Content="Ask assistant"/><ComboBoxItem Content="Verified research"/><ComboBoxItem Content="Multi-agent research"/></ComboBox>
         <Button x:Name="SendButton" Grid.Column="1" Click="Send" Style="{StaticResource AccentButtonStyle}" CornerRadius="18" Width="38" Height="38" Padding="0" AutomationProperties.Name="Send message" ToolTipService.ToolTip="Send (Ctrl+Enter)"><SymbolIcon Symbol="Send"/></Button>
        </Grid>
        <TextBlock Text="Verify numerical results before making engineering decisions." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       </StackPanel>
      </Border>
     </Grid>
     <Grid x:Name="TasksPage" Visibility="Collapsed" Padding="24,20" RowSpacing="12" MaxWidth="1120"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Spacing="4"><TextBlock Text="Research tasks" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Review task status, approvals and recovery." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto"><AppBarButton Click="StartResearchManifest" Label="Open manifest"><AppBarButton.Icon><SymbolIcon Symbol="OpenFile"/></AppBarButton.Icon></AppBarButton><AppBarButton Click="ResearchStatus" Label="Details"><AppBarButton.Icon><SymbolIcon Symbol="View"/></AppBarButton.Icon></AppBarButton><AppBarButton Click="ResumeResearch" Label="Resume"><AppBarButton.Icon><SymbolIcon Symbol="Play"/></AppBarButton.Icon></AppBarButton><CommandBar.SecondaryCommands><AppBarButton Click="RunVerifiedPython" Label="Run verified Python…"/><AppBarButton Click="CancelResearch" Label="Cancel selected task"/><AppBarButton Click="ApproveResearch" Label="Approve repair"/><AppBarButton Click="ClarifyResearch" Label="Answer question"/><AppBarButton Click="ExportResearch" Label="Export JSON"/></CommandBar.SecondaryCommands></CommandBar><ListView Grid.Row="2" x:Name="ResearchList" DisplayMemberPath="Label" SelectionMode="Single" AutomationProperties.Name="ResearchList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle></ListView></Grid>
     <Grid x:Name="ModelsPage" Visibility="Collapsed" Padding="24,20" RowSpacing="12" MaxWidth="1120"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Spacing="4"><TextBlock Text="Models" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Inspect imported models and immutable model revisions." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto"><AppBarButton Click="ImportModel" Label="Import model"><AppBarButton.Icon><SymbolIcon Symbol="OpenFile"/></AppBarButton.Icon></AppBarButton><AppBarButton Click="ModelRevisionDiff" Label="View changes"><AppBarButton.Icon><SymbolIcon Symbol="View"/></AppBarButton.Icon></AppBarButton><AppBarButton Click="RunModelRevision" Label="Run version"><AppBarButton.Icon><SymbolIcon Symbol="Play"/></AppBarButton.Icon></AppBarButton><CommandBar.SecondaryCommands><AppBarButton Click="Models" Label="Available models"/></CommandBar.SecondaryCommands></CommandBar><ListView Grid.Row="2" x:Name="ModelRevisions" DisplayMemberPath="Label" SelectionMode="Single" AutomationProperties.Name="ModelRevisions" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle></ListView></Grid>
     <Grid x:Name="RunsPage" Visibility="Collapsed" Padding="24,20" RowSpacing="12" MaxWidth="1120"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Spacing="4"><TextBlock Text="Simulation results" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Select a run to inspect the data, or select two to four to compare waveforms." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto"><AppBarButton Click="Runs" Label="Refresh"><AppBarButton.Icon><SymbolIcon Symbol="Refresh"/></AppBarButton.Icon></AppBarButton><AppBarButton Click="OpenWaveform" Label="Waveform"><AppBarButton.Icon><SymbolIcon Symbol="View"/></AppBarButton.Icon></AppBarButton><AppBarButton Click="OpenScientificCharts" Label="Charts"><AppBarButton.Icon><SymbolIcon Symbol="Library"/></AppBarButton.Icon></AppBarButton><CommandBar.SecondaryCommands><AppBarButton Click="OverlayWaveforms" Label="Compare waveforms"/><AppBarButton Click="OpenTopology" Label="Topology and parameters"/></CommandBar.SecondaryCommands></CommandBar><ListView Grid.Row="2" x:Name="RunList" DisplayMemberPath="Label" SelectionMode="Multiple" AutomationProperties.Name="RunList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle></ListView></Grid>
     <Grid x:Name="StudiesPage" Visibility="Collapsed" Padding="24,20" RowSpacing="12" MaxWidth="1120">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Spacing="4"><TextBlock Text="Studies and conversations" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Open a saved conversation or inspect a study." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
 <TabView Grid.Row="1" IsAddTabButtonVisible="False">
  <TabViewItem Header="Conversations" IsClosable="False"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBox x:Name="SessionSearch" PlaceholderText="Search conversations" TextChanged="SearchSessions" AutomationProperties.Name="Search conversations"/>
   <CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto"><AppBarButton Click="OpenSession" Label="Open"><AppBarButton.Icon><SymbolIcon Symbol="OpenFile"/></AppBarButton.Icon></AppBarButton><AppBarButton Click="NewSession" Label="New conversation"><AppBarButton.Icon><SymbolIcon Symbol="Add"/></AppBarButton.Icon></AppBarButton></CommandBar><ListView Grid.Row="2" x:Name="SessionList" DisplayMemberPath="Label" SelectionMode="Single" AutomationProperties.Name="SessionList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle></ListView>
  </Grid></TabViewItem>
  <TabViewItem Header="Studies" IsClosable="False"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="Saved reports" Style="{StaticResource SubtitleTextBlockStyle}"/>
   <CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto"><AppBarButton Click="OpenStudy" Label="Open report"><AppBarButton.Icon><SymbolIcon Symbol="OpenFile"/></AppBarButton.Icon></AppBarButton><AppBarButton Click="ResumeDsr" Label="Resume DSR"><AppBarButton.Icon><SymbolIcon Symbol="Play"/></AppBarButton.Icon></AppBarButton></CommandBar><ListView Grid.Row="2" x:Name="StudyList" DisplayMemberPath="Label" SelectionMode="Single" AutomationProperties.Name="StudyList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle></ListView>
  </Grid></TabViewItem>
 </TabView>
 </Grid>
     <ScrollViewer x:Name="ToolsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Engineering tools" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Explicit operations for simulation, reproduction and evaluation." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="Simulation" Style="{StaticResource SubtitleTextBlockStyle}"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Simulation program…" Click="NativeProgram"/><Button Margin="0,0,8,8" Content="ANDES batch…" Click="AndesBatch"/><Button Margin="0,0,8,8" Content="Eigenanalysis" Click="Eigen"/><Button Margin="0,0,8,8" Content="Optimize dispatch" Click="Optimize"/><Button Margin="0,0,8,8" Content="Open DMQ" Click="Dmq"/><Button Margin="0,0,8,8" Content="DMQ reference" Click="DmqReference"/><Button Margin="0,0,8,8" Content="Open DSR…" Click="Dsr"/></VariableSizedWrapGrid><TextBlock Text="Paper reproduction" Style="{StaticResource SubtitleTextBlockStyle}"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Paper DMQ…" Click="PaperDmq"/><Button Margin="0,0,8,8" Content="Paper DSR…" Click="PaperDsr"/><Button Margin="0,0,8,8" Content="Mitigation…" Click="PaperMitigation"/><Button Margin="0,0,8,8" Content="DSR ranking" Click="PaperRank"/><Button Margin="0,0,8,8" Content="KPI CSV…" Click="PaperKpi"/></VariableSizedWrapGrid><TextBlock Text="Evaluation and safety" Style="{StaticResource SubtitleTextBlockStyle}"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Benchmark and repair…" Click="ModelRepair"/><Button Margin="0,0,8,8" Content="Modeling benchmark…" Click="ModelingBenchmark"/><Button Margin="0,0,8,8" Content="Engineering experience" Click="Experience"/><Button Margin="0,0,8,8" Content="Review Python draft…" Click="ReviewScript"/></VariableSizedWrapGrid></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="PluginsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Simulation plugins" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Install only the optional solvers you need. No marketplace or bundled downloads." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh catalog" Click="PluginCenter"/><Button Content="Register ngspice…" Click="RegisterNgspice"/></StackPanel><TextBox x:Name="PluginSearch" PlaceholderText="Search plugins" TextChanged="FilterPlugins" AutomationProperties.Name="Search plugins"/><StackPanel x:Name="PluginRows" Spacing="12"/></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="KnowledgePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Engineering knowledge" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Manage local reference packs and engineering experience." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Import references…" Click="ImportKnowledge"/><Button Margin="0,0,8,8" Content="Knowledge packs" Click="Knowledge"/><Button Margin="0,0,8,8" Content="Engineering experience" Click="Experience"/></VariableSizedWrapGrid></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Padding="28,24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Workspace, provider and appearance." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="Workspace" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <TextBlock x:Name="RuntimeStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBox x:Name="WorkspacePath" Header="Workspace directory" IsReadOnly="True" AutomationProperties.Name="Workspace directory"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open workspace…" Click="OpenWorkspace"/><Button Content="Refresh workspace" Click="Refresh"/></StackPanel>
      <TextBlock Text="Model provider" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <TextBox x:Name="ModelName" Header="Model name"/><TextBox x:Name="BaseUrl" Header="Base URL"/><PasswordBox x:Name="ApiKey" Header="API key (session only)"/>
      <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"><Button Margin="0,0,8,8" Content="Load saved" Click="LoadModelSettings"/><Button Margin="0,0,8,8" Content="Save model" Click="SaveModelSettings"/><Button Margin="0,0,8,8" Content="Test connection" Click="TestModelConnection"/><Button Margin="0,0,8,8" Content="Automatic Python…" Click="PythonSettings"/></VariableSizedWrapGrid>
      <ToggleSwitch x:Name="StreamingToggle" Header="Stream responses" IsOn="True" OnContent="On" OffContent="Off"/><TextBlock Text="Disable streaming for endpoints that do not support it." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <ComboBox x:Name="Theme" Header="App theme" SelectedIndex="0" SelectionChanged="ChangeTheme"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
      <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
      <Button Content="About GridAgent" Click="ShowAbout"/>
      <Button Content="Open setup guide" Click="OpenSetupGuide"/>
     </StackPanel></StackPanel></ScrollViewer>
    </Grid>
    <Grid Grid.Row="2" Margin="12,8,12,0" ColumnSpacing="10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/>
     <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
     <Button Grid.Column="2" Content="Cancel research" Click="CancelResearch" x:Name="CancelButton" Visibility="Collapsed"/>
    </Grid>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
