<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Import the SDK's PRI/XAML publish targets even for the portable build.
         WindowsAppSDK #3718 / #6720: unpackaged publish may omit app resources. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GridAgent</AssemblyName>
    <ApplicationIcon Condition="Exists('BrandAssets\GridAgent.ico')">BrandAssets\GridAgent.ico</ApplicationIcon>
    <Product>GridAgent</Product>
    <Company>TopoDrive</Company>
    <Authors>Adex Hu</Authors>
    <Description>AI-assisted power system research workbench</Description>
    <Version>0.1.0</Version>
    <RootNamespace>GridAgent.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="BrandAssets\*.png;BrandAssets\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="CSharpMath.SkiaSharp" Version="0.5.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <Compile Include="../GridAgent.Windows/LocalEngine.cs" Link="LocalEngine.cs" />
  </ItemGroup>
  <Target Name="VerifyGridAgentPublishedResources" AfterTargets="Publish" Condition="'$(WindowsPackageType)' == 'None'">
    <!-- Guard against SDK regressions in the publish item list. Use only this build's
         own generated PRI, never a dependency PRI or a previous published artifact. -->
    <Copy SourceFiles="$(ProjectPriFullPath)" DestinationFolder="$(PublishDir)"
          Condition="'$(ProjectPriFullPath)' != '' And Exists('$(ProjectPriFullPath)') And !Exists('$(PublishDir)$(ProjectPriFileName)')" />
    <ItemGroup>
      <_GridAgentXbf Include="$(TargetDir)App.xbf" Condition="Exists('$(TargetDir)App.xbf')" />
      <_GridAgentXbf Include="$(TargetDir)MainWindow.xbf" Condition="Exists('$(TargetDir)MainWindow.xbf')" />
    </ItemGroup>
    <Copy SourceFiles="@(_GridAgentXbf)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="'@(_GridAgentXbf)' != ''" />
    <Error Condition="!Exists('$(PublishDir)resources.pri') And !Exists('$(PublishDir)$(AssemblyName).pri')"
           Text="GridAgent application PRI is missing from publish output. The WinUI app cannot be shipped without its resources." />
  </Target>
</Project>
