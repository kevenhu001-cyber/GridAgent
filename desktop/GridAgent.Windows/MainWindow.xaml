<Window x:Class="GridAgent.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="GridAgent" Height="840" Width="1200" MinHeight="620" MinWidth="840"
 Background="White" FontFamily="Segoe UI" FontSize="14">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="265"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="18">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="GridAgent" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
     <TextBlock Text="RESEARCH WORKSPACE" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
     <Button Content="+  New session" Click="NewSession"/>
     <Button Content="Refresh workspace" Click="Refresh"/>
     <Button Content="Open workspace…" Click="OpenWorkspace"/>
     <Expander Header="Models, plugins and knowledge" Margin="0,5,0,0">
      <ScrollViewer MaxHeight="275" VerticalScrollBarVisibility="Auto">
       <StackPanel>
     <Button Content="Import ANDES model…" Click="ImportModel"/>
     <Button Content="Available models" Click="Models"/>
     <Button Content="Simulation Plugins…" Click="PluginCenter"/>
     <Button Content="Register ngspice…" Click="RegisterNgspice"/>
     <Button Content="Run simulation program…" Click="NativeProgram"/>
     <Button Content="Benchmark and repair…" Click="ModelRepair"/>
     <Button Content="Engineering experience" Click="Experience"/>
     <Button Content="Modeling benchmark…" Click="ModelingBenchmark"/>
     <Button Content="Review Python draft…" Click="ReviewScript"/>
     <Button Content="Import engineering references…" Click="ImportKnowledge"/>
     <Button Content="Knowledge packs" Click="Knowledge"/>
       </StackPanel>
      </ScrollViewer>
     </Expander>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Local · ANDES · LangGraph" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
    <TabControl Margin="0,12,0,0" Background="Transparent" BorderThickness="0">
     <TabItem Header="Sessions">
      <DockPanel>
       <Button DockPanel.Dock="Bottom" Content="Open session" Click="OpenSession" Margin="0,8,0,0"/>
       <ListBox x:Name="SessionList" DisplayMemberPath="Label"/>
      </DockPanel>
     </TabItem>
     <TabItem Header="Studies">
      <DockPanel>
       <Button DockPanel.Dock="Bottom" Content="Open report" Click="OpenStudy" Margin="0,8,0,0"/>
       <ListBox x:Name="StudyList" DisplayMemberPath="Label"/>
      </DockPanel>
     </TabItem>
     <TabItem Header="Runs">
      <DockPanel>
       <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <Button Content="Waveform" Click="OpenWaveform"/>
        <Button Content="Overlay" Click="OverlayWaveforms"/>
        <Button Content="Charts" Click="OpenScientificCharts"/>
        <Button Content="Topology and edit" Click="OpenTopology"/>
       </WrapPanel>
       <ListBox x:Name="RunList" DisplayMemberPath="Label" SelectionMode="Extended"/>
      </DockPanel>
     </TabItem>
     <TabItem Header="Models">
      <DockPanel>
       <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <Button Content="View change" Click="ModelRevisionDiff"/>
        <Button Content="Run selected version" Click="RunModelRevision"/>
       </WrapPanel>
       <ListBox x:Name="ModelRevisions" DisplayMemberPath="Label"/>
      </DockPanel>
     </TabItem>
     <TabItem Header="Tasks">
      <DockPanel>
       <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <Button Content="Details" Click="ResearchStatus"/>
        <Button Content="Open manifest…" Click="StartResearchManifest"/>
        <Button Content="Resume" Click="ResumeResearch"/>
        <Button Content="Cancel" Click="CancelResearch"/>
        <Button Content="Approve repair" Click="ApproveResearch"/>
        <Button Content="Use prompt as answer" Click="ClarifyResearch"/>
        <Button Content="Export JSON" Click="ExportResearch"/>
       </WrapPanel>
       <ListBox x:Name="ResearchList" DisplayMemberPath="Label"/>
      </DockPanel>
     </TabItem>
    </TabControl>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,22,28,18">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    <TextBlock Text="Engineering assistant" FontSize="21" FontWeight="SemiBold"/>
   </DockPanel>
   <Expander Grid.Row="1" x:Name="ModelConfiguration" Header="Workspace and model settings" Margin="0,14,0,12">
    <Grid Margin="0,10,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <TextBlock Text="Research engine" VerticalAlignment="Center"/>
     <TextBlock x:Name="RuntimeStatus" Grid.Column="1" Margin="9,6" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
     <TextBlock Grid.Row="1" Text="Workspace" VerticalAlignment="Center"/>
     <TextBox x:Name="WorkspacePath" Grid.Row="1" Grid.Column="1" Margin="0,2" AutomationProperties.Name="Workspace"/>
     <TextBlock Grid.Row="2" Text="Model" VerticalAlignment="Center"/>
     <TextBox x:Name="ModelName" Grid.Row="2" Grid.Column="1" Margin="0,2" AutomationProperties.Name="Model"/>
     <TextBlock Grid.Row="3" Text="Base URL" VerticalAlignment="Center"/>
     <TextBox x:Name="BaseUrl" Grid.Row="3" Grid.Column="1" Margin="0,2" AutomationProperties.Name="Base URL"/>
     <TextBlock Grid.Row="4" Text="API key (session)" VerticalAlignment="Center"/>
     <PasswordBox x:Name="ApiKey" Grid.Row="4" Grid.Column="1" Margin="0,2" AutomationProperties.Name="API key"/>
     <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,8,0,0">
      <Button Content="Load saved" Click="LoadModelSettings"/>
      <Button Content="Save model" Click="SaveModelSettings"/>
      <Button Content="Test connection" Click="TestModelConnection"/>
      <Button Content="Automatic Python settings…" Click="PythonSettings"/>
     </WrapPanel>
    </Grid>
   </Expander>
   <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="0,12">
    <TextBox x:Name="Transcript" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
             Padding="4" FontSize="15" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Research transcript"/>
   </Border>
   <WrapPanel Grid.Row="3" Margin="0,14,0,3">
    <Button Content="Open DMQ" Click="Dmq"/>
    <Button Content="Paper DMQ…" Click="PaperDmq"/>
    <Button Content="Paper DSR…" Click="PaperDsr"/>
    <Button Content="Paper mitigation…" Click="PaperMitigation"/>
    <Button Content="Paper DSR ranking" Click="PaperRank"/>
    <Button Content="Paper KPI CSV…" Click="PaperKpi"/>
    <Button Content="DMQ reference" Click="DmqReference"/>
    <Button Content="Open DSR…" Click="Dsr"/>
    <Button Content="Eigenanalysis" Click="Eigen"/>
    <Button Content="ANDES batch…" Click="AndesBatch"/>
    <Button Content="Optimize" Click="Optimize"/>
    <Button Content="Runs" Click="Runs"/>
    <Button Content="Resume selected DSR" Click="ResumeDsr"/>
    <Button Content="Run research task" Click="StartResearch"/>
    <Button Content="Run with multiple agents" Click="StartMultiResearch"/>
    <Button Content="Run verified Python…" Click="RunVerifiedPython"/>
   </WrapPanel>
   <Grid Grid.Row="4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Prompt" MinHeight="60" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Research question" Margin="0,0,8,0"/>
    <Button Grid.Column="1" Content="Send" Background="#171717" Foreground="White" Padding="22,9"
            Click="Send" VerticalAlignment="Bottom" Margin="0"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
